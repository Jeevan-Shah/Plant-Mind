DATABASE_URL=sqlite:///backend/data/plantmind.db
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Knowledge graph backend: 'sqlite' (local fallback, default) or 'neo4j' (future).
GRAPH_BACKEND=sqlite
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM provider (optional). Leave LLM_API_KEY empty to use the built-in
# deterministic knowledge-graph fallback reasoning.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20

# Frontend usually uses Vite's proxy. For a separately hosted API, set:
# VITE_API_URL=http://localhost:8000
# V1 providers: sqlite graph, keyword retrieval, demo vision.
